{
  "name": "scrcpy-studio",
  "productName": "Scrcpy Studio",
  "version": "1.0.0",
  "description": "A beautiful, full-featured desktop GUI for scrcpy and adb",
  "main": "src/main/main.js",
  "author": "Augusto Migotto",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.js && node scripts/make-app-icon.js && node scripts/make-link-icon.js",
    "build:server": "node scripts/build-server.js",
    "build:vcam": "node scripts/build-vcam.js",
    "preview": "python -m http.server 5178 -d src/renderer",
    "dist": "electron-builder --win nsis portable --x64",
    "release": "electron-builder --win nsis portable --x64 --publish always"
  },
  "build": {
    "appId": "com.scrcpystudio.app",
    "productName": "Scrcpy Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "build/link.png",
      "build/link.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/scrcpy-server-studio",
        "to": "scrcpy-server-studio"
      },
      {
        "from": "resources/scrcpy-server-studio.version",
        "to": "scrcpy-server-studio.version"
      },
      {
        "from": "resources/vcam",
        "to": "vcam"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ScrcpyStudio-Setup-${version}.${ext}",
      "shortcutName": "Scrcpy Studio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ShadowAugust",
        "repo": "ScrcpyStudio",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "ScrcpyStudio-Portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-static": "^1.48.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadowAugust/ScrcpyStudio.git"
  },
  "homepage": "https://github.com/ShadowAugust/ScrcpyStudio"
}
